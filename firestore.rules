rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cloud save: each player can only read/write their OWN save.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.data is string
                   && request.resource.data.data.size() < 500000;
    }

    // Global leaderboard: everyone can read; a player can only write their own
    // row, the name must be short and the score can never go DOWN.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 16;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.score is int
                    && request.resource.data.score >= resource.data.score
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 16;
    }
  }
}
